# =============================================================================
# storage-service — configuracion
# Copiar a .env y completar. NUNCA commitear .env con valores reales.
# =============================================================================

# ----- Servidor HTTP ---------------------------------------------------------
PORT=3010
HOST=0.0.0.0
LOG_LEVEL=info

# ----- Que arranca este proceso ----------------------------------------------
# Permite correr API y recolector juntos, o separados en dos procesos.
API_ENABLED=true
WORKER_ENABLED=true

# ----- Base de datos ---------------------------------------------------------
DATABASE_URL=postgres://role_storage_service:role_storage_service@localhost:5432/storage_db
DB_POOL_MAX=10

# ----- Auth ------------------------------------------------------------------
# Via 1 — server-to-server: API keys por (cliente, app) en storage.api_keys.
# Emitir con:  npm run register:apikey -- --name "backend ERP" --customer <uuid> --app <uuid>
# La key se muestra una sola vez; en la base queda solo su SHA-256. Ya NO hay
# key en el entorno del servicio.

# Defaults opcionales SOLO para los scripts de registro (register-bucket /
# register-api-key): cliente y app por omision cuando no se pasan --customer /
# --app. El servicio en runtime no los lee. En integracion con la plataforma
# deben ser filas REALES de core.customers y core.apps de la base de admin.
#API_KEY_CUSTOMER_ID=00000000-0000-0000-0000-000000000000
#API_KEY_APP_ID=00000000-0000-0000-0000-000000000000

# Via 2 — usuarios finales: access tokens de auth_ws (Bearer JWT Ed25519).
# Definir la base de auth_ws ENCIENDE esta via: el servicio valida los tokens
# localmente (JWKS de /auth/.well-known/keys) y autoriza cada operacion contra
# los permisos storage.files.* de la sesion (/auth/sessions/current/permissions).
# Vacio/ausente = solo API key (comportamiento previo).
#AUTH_WS_BASE_URL=http://localhost:3001

# Origenes permitidos (CORS) para SPAs que llaman con el Bearer del usuario,
# separados por coma. Vacio = sin CORS (server-to-server no lo necesita).
#CORS_ORIGINS=http://localhost:4204,https://app.ejemplo.com

# ----- Contexto de auditoria -------------------------------------------------
# UUID de usuario de servicio: queda en created_by/updated_by de los archivos.
SERVICE_USER_ID=00000000-0000-0000-0000-000000000000
AUDIT_APP_NAME=storage-service

# ----- Almacenamiento --------------------------------------------------------
# Raiz del arbol de archivos. Debe existir o poder crearse, y estar en un disco
# con espacio: aca vive TODO el contenido. Ruta relativa se resuelve contra el
# directorio de trabajo del proceso.
STORAGE_ROOT=./data
# Techo global por archivo (100 MB). El limite por bucket puede ser menor; el
# menor de los dos manda siempre.
MAX_UPLOAD_BYTES=104857600

# ----- URLs firmadas de descarga ---------------------------------------------
# Clave HMAC de los enlaces temporales. Generar con: npm run gen:signkey
# Rotarla invalida en el acto TODOS los enlaces ya emitidos.
DOWNLOAD_SIGNING_KEY=REEMPLAZAR_POR_UNA_CLAVE_GENERADA_DE_32_BYTES
# Vigencia por defecto de un enlace (5 min) y tope que un cliente puede pedir.
DOWNLOAD_URL_TTL_SEC=300
DOWNLOAD_URL_MAX_TTL_SEC=86400
# Origen con el que se arman los enlaces. Detras de un proxy, el EXTERNO.
PUBLIC_BASE_URL=http://localhost:3010

# ----- Rate limiting ---------------------------------------------------------
# Limite por IP y ventana, en memoria (cada instancia cuenta por separado).
# /health* y los preflight OPTIONS estan exentos.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_SEC=60
#RATE_LIMIT_DISABLED=false
# Detras de un reverse proxy: true para que req.ip respete X-Forwarded-For.
# Expuesto directo a internet: false (el header seria forjable).
#TRUST_PROXY=false

# ----- Recolector de basura --------------------------------------------------
WORKER_INTERVAL_MS=60000
WORKER_BATCH_SIZE=50
# Un blob sin referencias no se borra hasta pasado este tiempo (15 min).
GC_GRACE_SEC=900
# Un temporal mas viejo que esto quedo de una subida que murio a mitad (1 h).
TMP_MAX_AGE_SEC=3600
# Cada cuanto reconciliar el disco contra storage.blobs y borrar archivos
# huerfanos (6 h). Recorre todo el arbol: no bajarlo sin motivo. 0 = apagado.
ORPHAN_SWEEP_INTERVAL_SEC=21600
